<UserControl x:Class="StudioManagement.WPF.Views.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    
    <UserControl.Resources>
        <SolidColorBrush x:Key="GoldAccentBrush" Color="#D97706" />
        <SolidColorBrush x:Key="CardBrush" Color="#1E293B" />
        <SolidColorBrush x:Key="BorderLightBrush" Color="#334155" />
        <SolidColorBrush x:Key="TextLightBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8" />

        <Style x:Key="WalletCardButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="60" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="#13233F" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#F59E0B" />
                                <Setter TargetName="bd" Property="Background" Value="#1C3058" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Action Bar -->
        <Border Grid.Row="0" Background="{StaticResource CardBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,14" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
            <DockPanel>
                <Button Content="+ إنشاء طلب جديد (Wizard)" Command="{Binding OpenNewOrderWizardCommand}" DockPanel.Dock="Left" Background="{StaticResource GoldAccentBrush}" Foreground="#0F172A" Padding="16,8" BorderThickness="0" FontWeight="Bold" FontSize="13" Cursor="Hand" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="بحث في الطلبات والفواتير:" VerticalAlignment="Center" Foreground="{StaticResource TextLightBrush}" FontWeight="Bold" Margin="0,0,10,0" />
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Width="320" Height="36" Padding="8,4" FontSize="13" VerticalContentAlignment="Center" Background="#0D1B36" Foreground="White" BorderBrush="{StaticResource BorderLightBrush}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Orders DataGrid with Large, Bold, Clear Typography -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}" AutoGenerateColumns="False" IsReadOnly="True" 
                  Background="{StaticResource CardBrush}" RowBackground="{StaticResource CardBrush}" AlternatingRowBackground="#182234" 
                  Foreground="{StaticResource TextLightBrush}" BorderBrush="{StaticResource BorderLightBrush}" GridLinesVisibility="Horizontal" HeadersVisibility="Column" FontSize="13">
            <DataGrid.Columns>
                <DataGridTextColumn Header="رقم الفاتورة والطلب" Binding="{Binding OrderNumber}" Width="150" FontWeight="Bold" />
                <DataGridTextColumn Header="اسم العميل" Binding="{Binding CustomerName}" Width="180" FontWeight="Bold" />
                <DataGridTextColumn Header="نوع الخدمة" Binding="{Binding ServiceTitle}" Width="200" />
                <DataGridTextColumn Header="تاريخ الطلب" Binding="{Binding OrderDate, StringFormat='{}{0:yyyy/MM/dd}'}" Width="110" />
                <DataGridTextColumn Header="موعد التسليم" Binding="{Binding DeliveryDate, StringFormat='{}{0:yyyy/MM/dd}'}" Width="110" />
                <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalAmount, StringFormat='{}{0:N0} ر.ي'}" Width="120" FontWeight="Bold" />
                <DataGridTextColumn Header="المدفوع" Binding="{Binding PaidAmount, StringFormat='{}{0:N0} ر.ي'}" Width="120" Foreground="#10B981" FontWeight="Bold" />
                <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingAmount, StringFormat='{}{0:N0} ر.ي'}" Width="120" Foreground="#EF4444" FontWeight="Bold" />
                <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="110" />
                <DataGridTemplateColumn Header="إجراءات الفاتورة والدفع" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="🖨️ طباعة الفاتورة" Command="{Binding DataContext.PrintInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="#1E3A8A" Foreground="White" BorderThickness="0" Padding="10,4" Margin="2,0" FontWeight="Bold" Cursor="Hand" />
                                <Button Content="💵 إضافة دفعة" Command="{Binding DataContext.OpenAddPaymentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="{StaticResource GoldAccentBrush}" Foreground="#0F172A" BorderThickness="0" Padding="10,4" Margin="2,0" FontWeight="Bold" Cursor="Hand" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Payment Modal Overlay (with Wallets & Multi-Payment History) -->
        <Grid Grid.RowSpan="2" Background="#CC000000" Visibility="{Binding IsPaymentOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border MaxWidth="620" VerticalAlignment="Center" Background="#0F172A" BorderBrush="{StaticResource GoldAccentBrush}" BorderThickness="2" CornerRadius="20" Padding="24">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="تسجيل دفعة للفاتورة (نقدي / محافظ بنكية)" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextLightBrush}" />
                        <Button Content="✕" Command="{Binding ClosePaymentCommand}" HorizontalAlignment="Left" Background="Transparent" Foreground="White" FontSize="16" BorderThickness="0" Cursor="Hand" />
                    </Grid>

                    <Border Background="#1E293B" CornerRadius="10" Padding="12" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="العميل: " Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding SelectedOrder.CustomerName}" FontWeight="Bold" Foreground="White" FontSize="15" />
                                <TextBlock Text="{Binding SelectedOrder.OrderNumber, StringFormat='فاتورة رقم: {0}'}" Foreground="{StaticResource GoldAccentBrush}" FontSize="12" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Left">
                                <TextBlock Text="المتبقي للتحصيل:" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding SelectedOrder.RemainingAmount, StringFormat='{}{0:N0} ر.ي'}" FontWeight="Black" Foreground="#EF4444" FontSize="18" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Payment Amount Field -->
                    <TextBlock Text="مبلغ الدفعة المراد تحصيله:" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextLightBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged}" Height="40" FontSize="16" FontWeight="Bold" Background="#0D1B36" Foreground="#10B981" BorderBrush="{StaticResource BorderLightBrush}" Padding="8,4" Margin="0,0,0,14" />

                    <!-- Payment Method / Wallets Grid (With High Quality Wallet Cards) -->
                    <TextBlock Text="طريقة التحصيل (اختر المحفظة أو الدفع النقدي):" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextLightBrush}" Margin="0,0,0,8" />
                    <UniformGrid Columns="3" Margin="0,0,0,14">
                        <!-- Cash -->
                        <Button Style="{StaticResource WalletCardButtonStyle}" Command="{Binding SelectCashCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💵" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="دفع نقدي" FontWeight="Bold" FontSize="13" />
                                    <TextBlock Text="الصندوق المباشر" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <!-- Jeeb -->
                        <Button Style="{StaticResource WalletCardButtonStyle}" Command="{Binding SelectWalletCommand}" CommandParameter="Jeeb">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💳" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#F59E0B" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="محفظة جيب" FontWeight="Bold" FontSize="13" Foreground="#F59E0B" />
                                    <TextBlock Text="بنك اليمن الدولي" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <!-- Jawwali -->
                        <Button Style="{StaticResource WalletCardButtonStyle}" Command="{Binding SelectWalletCommand}" CommandParameter="Jawwali">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📱" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#10B981" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="محفظة جوالي" FontWeight="Bold" FontSize="13" Foreground="#10B981" />
                                    <TextBlock Text="الشركة المتحدة" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <!-- OneCash -->
                        <Button Style="{StaticResource WalletCardButtonStyle}" Command="{Binding SelectWalletCommand}" CommandParameter="OneCash">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💎" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#3B82F6" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="محفظة ون كاش" FontWeight="Bold" FontSize="13" Foreground="#3B82F6" />
                                    <TextBlock Text="دفع سريع ومرن" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <!-- Floosak -->
                        <Button Style="{StaticResource WalletCardButtonStyle}" Command="{Binding SelectWalletCommand}" CommandParameter="Floosak">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⭐" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#8B5CF6" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="محفظة فلوسك" FontWeight="Bold" FontSize="13" Foreground="#8B5CF6" />
                                    <TextBlock Text="بنك اليمن والكويت" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <!-- Kuraimi -->
                        <Button Style="{StaticResource WalletCardButtonStyle}" Command="{Binding SelectWalletCommand}" CommandParameter="Kuraimi">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏦" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#EC4899" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="محفظة كريمي" FontWeight="Bold" FontSize="13" Foreground="#EC4899" />
                                    <TextBlock Text="إم فلوس / الكريمي" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <!-- Transaction Reference & Sender Name -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="رقم العملية / الحوالة / السند:" FontSize="11" Foreground="{StaticResource TextLightBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding TransactionNumber, UpdateSourceTrigger=PropertyChanged}" Height="36" Background="#0D1B36" Foreground="White" BorderBrush="{StaticResource BorderLightBrush}" Padding="8,4" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="اسم المرسل / رقم الهاتف:" FontSize="11" Foreground="{StaticResource TextLightBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding SenderName, UpdateSourceTrigger=PropertyChanged}" Height="36" Background="#0D1B36" Foreground="White" BorderBrush="{StaticResource BorderLightBrush}" Padding="8,4" />
                        </StackPanel>
                    </Grid>

                    <!-- Action Buttons -->
                    <DockPanel>
                        <Button Content="تأكيد وتسجيل الدفعة" Command="{Binding SubmitPaymentCommand}" Background="{StaticResource GoldAccentBrush}" Foreground="#0F172A" FontWeight="Black" FontSize="14" Padding="20,10" BorderThickness="0" Cursor="Hand" />
                        <Button Content="إلغاء" Click="{Binding IsPaymentOpen, Mode=OneWayToSource}" HorizontalAlignment="Left" Background="#334155" Foreground="White" FontWeight="Bold" FontSize="13" Padding="16,10" BorderThickness="0" Cursor="Hand" Margin="10,0,0,0" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
