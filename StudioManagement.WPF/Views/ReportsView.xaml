<UserControl x:Class="StudioManagement.WPF.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <SolidColorBrush x:Key="GoldAccentBrush" Color="#D97706" />
        <SolidColorBrush x:Key="CardBrush" Color="#1E293B" />
        <SolidColorBrush x:Key="BorderLightBrush" Color="#334155" />
        <SolidColorBrush x:Key="TextLightBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8" />

        <Style x:Key="ReportCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="ReportBtnStyle" TargetType="Button">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource GoldAccentBrush}" Margin="0,0,12,0">
                        <TextBlock Text="📈" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="مركز التقارير والكشوفات المالية الرسمية" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextLightBrush}" />
                        <TextBlock Text="تقارير الأرباح والخسائر، المبيعات والتحصيل، ديون ومستحقات العملاء، مسيرات الرواتب والمخزون مع الطباعة المعتمدة" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Period Range Selector Bar -->
            <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,16" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="من تاريخ:" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource TextLightBrush}" Margin="0,0,8,0" />
                    <DatePicker Grid.Column="1" SelectedDate="{Binding FromDate}" Height="34" />

                    <TextBlock Grid.Column="2" Text="إلى تاريخ:" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource TextLightBrush}" Margin="16,0,8,0" />
                    <DatePicker Grid.Column="3" SelectedDate="{Binding ToDate}" Height="34" />

                    <TextBlock Grid.Column="4" Text="💡 حدد الفترة الزمنية قبل فتح أو طباعة التقارير الدورية" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="16,0,0,0" />
                </Grid>
            </Border>

            <!-- Reports Grid -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Report 1: تقرير المبيعات والإيرادات -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource ReportCardStyle}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="📊" FontSize="20" Margin="0,0,8,0" />
                            <TextBlock Text="تقرير المبيعات والإيرادات التفصيلي" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextLightBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="كشف كامل بكافة الطلبات المحققة والمبالغ المقبوضة نقدياً وبالمحافظ والديون المتبقية ومؤشرات النمو اليومية والأسبوعية." TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,16" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Button Content="🖨️ فتح ومعاينة التقرير" Command="{Binding OpenSalesReportCommand}" Background="{StaticResource GoldAccentBrush}" Foreground="#0F172A" Style="{StaticResource ReportBtnStyle}" Margin="0,0,8,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Report 2: تقرير الأرباح والخسائر الشامل -->
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource ReportCardStyle}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="💰" FontSize="20" Margin="0,0,8,0" />
                            <TextBlock Text="تقرير الأرباح والخسائر (قائمة الدخل)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextLightBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="مقارنة دقيقة بين إجمالي الدخل المحصل والمصروفات التشغيلية ومشتريات الخامات لحساب صافي الربح الحقيقي للاستديو." TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,16" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Button Content="🖨️ فتح قائمة الدخل والربح" Command="{Binding OpenProfitLossReportCommand}" Background="#16A34A" Foreground="White" Style="{StaticResource ReportBtnStyle}" Margin="0,0,8,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Report 3: كشف ديون ومستحقات العملاء -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ReportCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="⚠️" FontSize="20" Margin="0,0,8,0" />
                            <TextBlock Text="كشف ديون ومستحقات العملاء غير المسددة" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextLightBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="حصر شامل لجميع الذمم المدينة على العملاء المستحق تحصيلها عند استلام الطلبات مع أرقام هواتفهم وتاريخ التسليم." TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,16" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Button Content="🖨️ فتح كشف الديون المستحقة" Command="{Binding OpenDebtsReportCommand}" Background="#DC2626" Foreground="White" Style="{StaticResource ReportBtnStyle}" Margin="0,0,8,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Report 4: تقرير جرد المخزون والخامات -->
                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource ReportCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="📦" FontSize="20" Margin="0,0,8,0" />
                            <TextBlock Text="تقرير جرد المخزون والخامات وقيمتها" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextLightBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="جرد كامل للأقمشة الكانفس، الألواح الخشبية، إطارات الألبومات، أحبار الطباعة والمواد النافدة مع التكلفة التقديرية." TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,16" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Button Content="🖨️ فتح تقرير جرد المخزون" Command="{Binding OpenInventoryReportCommand}" Background="#0284C7" Foreground="White" Style="{StaticResource ReportBtnStyle}" Margin="0,0,8,0" />
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
