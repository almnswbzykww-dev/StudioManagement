{
  "DatabaseProvider": "Sqlite",
  "ConnectionStrings": {
    "SqliteDb": "Data Source=StudioManagement.db",
    "StudioDb": "Server=.\\SQLEXPRESS;Database=StudioManagementDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true;Connect Timeout=3;"
  },
  "StudioSettings": {
    "AutoBackup": true,
    "BackupFolder": "Backups",
    "MaxBackupCopies": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
