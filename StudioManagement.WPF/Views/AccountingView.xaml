<UserControl x:Class="StudioManagement.WPF.Views.AccountingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <SolidColorBrush x:Key="GoldAccentBrush" Color="#D97706" />
        <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#0B132B" />
        <SolidColorBrush x:Key="BrandSecondaryBrush" Color="#1C2541" />
        <SolidColorBrush x:Key="CardBrush" Color="#1E293B" />
        <SolidColorBrush x:Key="BorderLightBrush" Color="#334155" />
        <SolidColorBrush x:Key="TextLightBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8" />

        <Style x:Key="PrimaryTabStyle" TargetType="TabItem">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="8,8,0,0" Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#0F172A" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#D97706" />
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="1,2,1,0" />
                                <Setter Property="Foreground" Value="#F8FAFC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <!-- Main Content Area -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header & Page Close Button -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource GoldAccentBrush}" Margin="0,0,12,0">
                        <TextBlock Text="💼" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="الموارد والمالية والحسابات الشاملة" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextLightBrush}" />
                        <TextBlock Text="إدارة الموظفين والرواتب والسلف والمديونيات، السندات والفواتير، الصندوق وحسابات البنوك، وكشوف الحسابات الرسمية" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Status / Treasury Quick Indicator -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Border Background="#1E293B" CornerRadius="10" Padding="12,6" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="رصيد الخزينة: " FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TreasuryBalance, StringFormat='{}{0:N0} ر.ي'}" FontSize="13" FontWeight="Black" Foreground="{StaticResource GoldAccentBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Comprehensive Accounting Tabs -->
            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" SelectedIndex="{Binding SelectedTabIndex}">
                
                <!-- TAB 1: الموظفون والرواتب والمديونيات -->
                <TabItem Header="👥 الموظفون والرواتب والمديونيات" Style="{StaticResource PrimaryTabStyle}">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Top Toolbar for Employees -->
                        <Border Grid.Row="0" Background="{StaticResource CardBrush}" CornerRadius="12" Padding="12,14" Margin="0,0,0,12" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Action Buttons -->
                                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                    <Button Content="➕ تسجيل موظف جديد" Command="{Binding OpenNewEmployeeModalCommand}" 
                                            Background="{StaticResource GoldAccentBrush}" Foreground="#0F172A" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" />
                                    
                                    <Button Content="💵 تسجيل سلفة" Command="{Binding OpenAdvanceModalCommand}" 
                                            Background="#2563EB" Foreground="White" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" />

                                    <Button Content="✂️ تسجيل خصم" Command="{Binding OpenDeductionModalCommand}" 
                                            Background="#DC2626" Foreground="White" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" />

                                    <Button Content="⚠️ تسجيل مديونية" Command="{Binding OpenDebtModalCommand}" 
                                            Background="#EA580C" Foreground="White" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" />

                                    <Button Content="💳 سداد دفعة / مديونية" Command="{Binding OpenPaymentModalCommand}" 
                                            Background="#16A34A" Foreground="White" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" />

                                    <Button Content="💰 صرف راتب شهري" Command="{Binding OpenSalaryModalCommand}" 
                                            Background="#059669" Foreground="White" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" />

                                    <Button Content="🖨️ طباعة مسير الرواتب" Command="{Binding PrintPayrollCommand}" 
                                            Background="#475569" Foreground="White" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" />
                                </WrapPanel>

                                <!-- Employee Search Box -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="بحث في الموظفين:" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,8,0" />
                                    <TextBox Text="{Binding EmployeeSearch, UpdateSourceTrigger=PropertyChanged}" Width="190" Height="34" VerticalContentAlignment="Center" Padding="8,0" Background="#0F172A" Foreground="White" BorderBrush="{StaticResource BorderLightBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Employee Metrics Cards -->
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="12" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="👥 إجمالي كادر الموظفين" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding Employees.Count, StringFormat='{}{0} موظف'}" FontSize="17" FontWeight="Black" Foreground="{StaticResource TextLightBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="12" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="💵 السلف القائمة" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="متابعة آلية على الرواتب" FontSize="15" FontWeight="Bold" Foreground="#3B82F6" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="12" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="⚠️ مديونيات مستحقة" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="تخصم أو تسدد نقدياً" FontSize="15" FontWeight="Bold" Foreground="#EF4444" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="6" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="12" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="📑 كشوفات الحساب" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="مستقلة وتفصيلية" FontSize="15" FontWeight="Bold" Foreground="{StaticResource GoldAccentBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Employees DataGrid -->
                        <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="12" Padding="14" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                            <DataGrid ItemsSource="{Binding FilteredEmployees}" AutoGenerateColumns="False" 
                                      CanUserAddRows="False" IsReadOnly="True" Background="#0D1B36" Foreground="{StaticResource TextLightBrush}" 
                                      BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="الرقم الوظيفي" Binding="{Binding EmpNumber}" Width="100" />
                                    <DataGridTextColumn Header="اسم الموظف" Binding="{Binding Name}" Width="160" />
                                    <DataGridTextColumn Header="الوظيفة / التخصص" Binding="{Binding Role}" Width="160" />
                                    <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="110" />
                                    <DataGridTextColumn Header="تاريخ التوظيف" Binding="{Binding HireDate, StringFormat='{}{0:yyyy/MM/dd}'}" Width="100" />
                                    <DataGridTextColumn Header="الراتب المتفق عليه" Binding="{Binding BaseSalary, StringFormat='{}{0:N0} ر.ي'}" Width="130" />
                                    <DataGridTextColumn Header="السلف القائمة" Binding="{Binding PendingAdvances, StringFormat='{}{0:N0}'}" Width="100" />
                                    <DataGridTextColumn Header="المديونية" Binding="{Binding TotalDebts, StringFormat='{}{0:N0}'}" Width="100" />
                                    <DataGridTextColumn Header="الخصومات" Binding="{Binding TotalDeductions, StringFormat='{}{0:N0}'}" Width="90" />
                                    <DataGridTextColumn Header="صافي الراتب المستحق" Binding="{Binding NetDueSalary, StringFormat='{}{0:N0} ر.ي'}" Width="140" />
                                    
                                    <!-- Action Buttons Column -->
                                    <DataGridTemplateColumn Header="إجراءات الموارد والمالية" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <!-- Print Statement Button -->
                                                    <Button Content="🖨️ كشف حساب" Command="{Binding DataContext.PrintEmployeeStatementCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" 
                                                            Background="#0284C7" Foreground="White" FontSize="11" Padding="8,4" Margin="2,0" Style="{StaticResource ActionButtonStyle}" ToolTip="طباعة كشف حساب مستقل للموظف" />

                                                    <!-- Advance Button -->
                                                    <Button Content="💵 سلفة" Command="{Binding DataContext.OpenAdvanceModalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" 
                                                            Background="#2563EB" Foreground="White" FontSize="11" Padding="8,4" Margin="2,0" Style="{StaticResource ActionButtonStyle}" ToolTip="صرف سلفة نقدية" />

                                                    <!-- Deduction Button -->
                                                    <Button Content="✂️ خصم" Command="{Binding DataContext.OpenDeductionModalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" 
                                                            Background="#DC2626" Foreground="White" FontSize="11" Padding="8,4" Margin="2,0" Style="{StaticResource ActionButtonStyle}" ToolTip="تسجيل خصم إداري" />

                                                    <!-- Debt Button -->
                                                    <Button Content="⚠️ مديونية" Command="{Binding DataContext.OpenDebtModalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" 
                                                            Background="#EA580C" Foreground="White" FontSize="11" Padding="8,4" Margin="2,0" Style="{StaticResource ActionButtonStyle}" ToolTip="تسجيل مديونية مستحقة" />

                                                    <!-- Repay Button -->
                                                    <Button Content="💳 سداد" Command="{Binding DataContext.OpenPaymentModalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" 
                                                            Background="#16A34A" Foreground="White" FontSize="11" Padding="8,4" Margin="2,0" Style="{StaticResource ActionButtonStyle}" ToolTip="سداد دفعة نقدية" />

                                                    <!-- Pay Salary Button -->
                                                    <Button Content="💰 راتب" Command="{Binding DataContext.OpenSalaryModalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" 
                                                            Background="#059669" Foreground="White" FontSize="11" Padding="8,4" Margin="2,0" Style="{StaticResource ActionButtonStyle}" ToolTip="صرف وتصفية الراتب الشهري" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB 2: السندات المالية والفواتير (قبض وصرف وبحث ومراجعة) -->
                <TabItem Header="📜 السندات المالية والفواتير" Style="{StaticResource PrimaryTabStyle}">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Search & Filter Bar for Vouchers (Requirement 4: البحث والمراجعة وإعادة الطباعة) -->
                        <Border Grid.Row="0" Background="{StaticResource CardBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,12" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Top Voucher Action Buttons -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                    <Button Content="➕ سند قبض جديد (إيراد)" Command="{Binding OpenNewVoucherModalCommand}" CommandParameter="قبض" 
                                            Background="#16A34A" Foreground="White" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" />

                                    <Button Content="➕ سند صرف جديد (مصروف/دفعة)" Command="{Binding OpenNewVoucherModalCommand}" CommandParameter="صرف" 
                                            Background="#DC2626" Foreground="White" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" />

                                    <Button Content="🖨️ إعادة طباعة السند المحدد دون تكرار القيد" Command="{Binding ReprintVoucherCommand}" CommandParameter="{Binding ElementName=VouchersGrid, Path=SelectedItem}" 
                                            Background="{StaticResource GoldAccentBrush}" Foreground="#0F172A" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" />
                                </StackPanel>

                                <!-- Search & Review Filter Criteria -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Voucher Type Filter -->
                                    <TextBlock Grid.Column="0" Text="نوع السند:" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0" FontSize="12" />
                                    <ComboBox Grid.Column="1" SelectedValue="{Binding VoucherFilterType, Mode=TwoWay}" SelectedValuePath="Content" Height="32" FontSize="12">
                                        <ComboBoxItem Content="الكل" IsSelected="True" />
                                        <ComboBoxItem Content="قبض" />
                                        <ComboBoxItem Content="صرف" />
                                    </ComboBox>

                                    <!-- From Date -->
                                    <TextBlock Grid.Column="2" Text="من تاريخ:" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Margin="12,0,6,0" FontSize="12" />
                                    <DatePicker Grid.Column="3" SelectedDate="{Binding VoucherFromDate}" Height="32" />

                                    <!-- To Date -->
                                    <TextBlock Grid.Column="4" Text="إلى تاريخ:" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Margin="12,0,6,0" FontSize="12" />
                                    <DatePicker Grid.Column="5" SelectedDate="{Binding VoucherToDate}" Height="32" />

                                    <!-- Text Search -->
                                    <TextBlock Grid.Column="6" Text="رقم السند أو المستفيد:" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Margin="12,0,6,0" FontSize="12" />
                                    <TextBox Grid.Column="7" Text="{Binding VoucherSearch, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" Padding="8,0" Background="#0F172A" Foreground="White" BorderBrush="{StaticResource BorderLightBrush}" />

                                    <!-- Filter Button -->
                                    <Button Grid.Column="8" Content="🔎 بحث ومراجعة" Command="{Binding ApplyVoucherFilterCommand}" 
                                            Background="#2563EB" Foreground="White" Style="{StaticResource ActionButtonStyle}" Margin="8,0,0,0" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Vouchers Table -->
                        <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="12" Padding="14" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                            <DataGrid x:Name="VouchersGrid" ItemsSource="{Binding FilteredVouchers}" AutoGenerateColumns="False" 
                                      CanUserAddRows="False" IsReadOnly="True" Background="#0D1B36" Foreground="{StaticResource TextLightBrush}" 
                                      BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="رقم السند" Binding="{Binding VoucherNumber}" Width="120" />
                                    <DataGridTextColumn Header="نوع السند" Binding="{Binding TypeName}" Width="100" />
                                    <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat='{}{0:yyyy/MM/dd}'}" Width="95" />
                                    <DataGridTextColumn Header="الوقت" Binding="{Binding Time}" Width="85" />
                                    <DataGridTextColumn Header="المستفيد / الدافع" Binding="{Binding BeneficiaryOrPayer}" Width="170" />
                                    <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat='{}{0:N0} ر.ي'}" Width="110" />
                                    <DataGridTextColumn Header="التفقيط كتابة" Binding="{Binding AmountWords}" Width="160" />
                                    <DataGridTextColumn Header="طريقة الدفع" Binding="{Binding PaymentMethod}" Width="95" />
                                    <DataGridTextColumn Header="البيان والوصف" Binding="{Binding Description}" Width="200" />
                                    <DataGridTextColumn Header="المحرر" Binding="{Binding CreatedByName}" Width="110" />
                                    
                                    <DataGridTemplateColumn Header="معاينة وطباعة" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="🖨️ طباعة ومعاينة رسمية" Command="{Binding DataContext.PrintVoucherCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" 
                                                        Background="{StaticResource GoldAccentBrush}" Foreground="#0F172A" FontSize="11" Padding="10,4" Style="{StaticResource ActionButtonStyle}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB 3: الصندوق ودخل الكاشيرات (الحسابات الحالية) -->
                <TabItem Header="💰 الصندوق ودخل الكاشيرات" Style="{StaticResource PrimaryTabStyle}">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Top Metrics: دخل اليوم & رصيد الصندوق -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Card 1: دخل اليوم -->
                            <Border Grid.Column="0" Background="{StaticResource CardBrush}" CornerRadius="12" Padding="14" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="📊 إجمالي مبيعات اليوم" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding TodayIncome.TotalSales, StringFormat='{}{0:N0} ر.ي'}" FontSize="18" FontWeight="Black" Foreground="{StaticResource GoldAccentBrush}" Margin="0,4,0,2" />
                                    <TextBlock Text="{Binding TodayIncome.TotalOrdersCount, StringFormat='عدد الطلبات: {0}'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Card 2: المدفوع نقداً اليوم -->
                            <Border Grid.Column="2" Background="{StaticResource CardBrush}" CornerRadius="12" Padding="14" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="💵 مقبوض نقداً اليوم" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding TodayIncome.TotalCash, StringFormat='{}{0:N0} ر.ي'}" FontSize="18" FontWeight="Black" Foreground="#10B981" Margin="0,4,0,2" />
                                    <TextBlock Text="توريدات الصندوق المباشرة" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Card 3: المدفوع بالمحافظ والبنك اليوم -->
                            <Border Grid.Column="4" Background="{StaticResource CardBrush}" CornerRadius="12" Padding="14" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="📱 محافظ وبنك اليوم" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding TodayIncome.TotalBankAndWallets, StringFormat='{}{0:N0} ر.ي'}" FontSize="18" FontWeight="Black" Foreground="#3B82F6" Margin="0,4,0,2" />
                                    <TextBlock Text="جيب • جوالي • ون كاش • كريمي" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Card 4: المتبقي ديون اليوم -->
                            <Border Grid.Column="6" Background="{StaticResource CardBrush}" CornerRadius="12" Padding="14" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="⏳ ديون متبقية للتسليم" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding TodayIncome.TotalRemaining, StringFormat='{}{0:N0} ر.ي'}" FontSize="18" FontWeight="Black" Foreground="#EF4444" Margin="0,4,0,2" />
                                    <TextBlock Text="مستحقات عند التسليم" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Bottom Body: Cashier Income Filter & Report Details -->
                        <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="14" Padding="20" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Filter Bar: دخل الكاشير -->
                                <Border Grid.Row="0" Background="#0D1B36" CornerRadius="12" Padding="14" Margin="0,0,0,16" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Cashier Selector -->
                                        <TextBlock Grid.Column="0" Text="الكاشير:" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource TextLightBrush}" Margin="0,0,8,0" />
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding CashiersList}" SelectedItem="{Binding SelectedFilterCashier}" Height="36" FontSize="12">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding FullName}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <!-- From Date -->
                                        <TextBlock Grid.Column="2" Text="من تاريخ:" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource TextLightBrush}" Margin="12,0,8,0" />
                                        <DatePicker Grid.Column="3" SelectedDate="{Binding FilterFromDate}" Height="36" />

                                        <!-- To Date -->
                                        <TextBlock Grid.Column="4" Text="إلى تاريخ:" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource TextLightBrush}" Margin="12,0,8,0" />
                                        <DatePicker Grid.Column="5" SelectedDate="{Binding FilterToDate}" Height="36" />

                                        <!-- Search Button -->
                                        <Button Grid.Column="6" Content="🔎 بحث في دخل الكاشير" Command="{Binding SearchCashierIncomeCommand}" 
                                                Background="{StaticResource GoldAccentBrush}" Foreground="#0F172A" FontWeight="Bold" FontSize="13" Padding="16,8" BorderThickness="0" Margin="16,0,0,0" Cursor="Hand" />

                                        <!-- Print Report Button -->
                                        <Button Grid.Column="7" Content="🖨️ طباعة تقرير الدخل" Command="{Binding PrintCashierReportCommand}" 
                                                Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="13" Padding="16,8" BorderThickness="0" Margin="10,0,0,0" Cursor="Hand" />
                                    </Grid>
                                </Border>

                                <!-- Cashier Income Summary Banner -->
                                <Border Grid.Row="1" Background="#162544" CornerRadius="12" Padding="16" Margin="0,0,0,16" BorderBrush="{StaticResource GoldAccentBrush}" BorderThickness="1.5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CashierReport.CashierName, StringFormat='📊 تقرير دخل: {0}'}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextLightBrush}" />
                                            <TextBlock Text="{Binding CashierReport.PeriodFormatted}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="إجمالي المبيعات" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding CashierReport.TotalSales, StringFormat='{}{0:N0} ر.ي'}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource GoldAccentBrush}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="المقبوض نقداً" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding CashierReport.TotalCash, StringFormat='{}{0:N0} ر.ي'}" FontSize="15" FontWeight="Bold" Foreground="#10B981" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                            <TextBlock Text="المقبوض بالمحافظ" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding CashierReport.TotalWallets, StringFormat='{}{0:N0} ر.ي'}" FontSize="15" FontWeight="Bold" Foreground="#3B82F6" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                            <TextBlock Text="إجمالي المستلم" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding CashierReport.TotalReceived, StringFormat='{}{0:N0} ر.ي'}" FontSize="15" FontWeight="Black" Foreground="#10B981" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="5" VerticalAlignment="Center">
                                            <TextBlock Text="المتبقي ديون" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding CashierReport.TotalRemaining, StringFormat='{}{0:N0} ر.ي'}" FontSize="15" FontWeight="Bold" Foreground="#EF4444" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Detailed Orders Table -->
                                <DataGrid Grid.Row="2" ItemsSource="{Binding CashierReport.Orders}" AutoGenerateColumns="False" 
                                          CanUserAddRows="False" IsReadOnly="True" Background="#0D1B36" Foreground="{StaticResource TextLightBrush}" 
                                          BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="رقم الطلب / الفاتورة" Binding="{Binding OrderNumber}" Width="130" />
                                        <DataGridTextColumn Header="اسم العميل" Binding="{Binding CustomerName}" Width="160" />
                                        <DataGridTextColumn Header="الخدمة والمواصفات" Binding="{Binding ServiceTitle}" Width="200" />
                                        <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalAmount, StringFormat='{}{0:N0}'}" Width="110" />
                                        <DataGridTextColumn Header="المدفوع" Binding="{Binding PaidAmount, StringFormat='{}{0:N0}'}" Width="110" />
                                        <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingAmount, StringFormat='{}{0:N0}'}" Width="110" />
                                        <DataGridTextColumn Header="طريقة الدفع" Binding="{Binding PaymentMethodName}" Width="110" />
                                        <DataGridTextColumn Header="المحفظة / البنك" Binding="{Binding WalletName}" Width="130" />
                                        <DataGridTextColumn Header="التاريخ" Binding="{Binding DateFormatted}" Width="100" />
                                        <DataGridTextColumn Header="الوقت" Binding="{Binding TimeFormatted}" Width="90" />
                                        <DataGridTextColumn Header="الكاشير" Binding="{Binding CashierName}" Width="120" />
                                        <DataGridTemplateColumn Header="طباعة الإشعار" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="🖨️ طباعة الإشعار" 
                                                            Command="{Binding DataContext.PrintCashierOrderRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                            CommandParameter="{Binding}" 
                                                            Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="11" Padding="8,4" BorderThickness="0" Cursor="Hand" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB 4: المصروفات والإيرادات -->
                <TabItem Header="💳 المصروفات والإيرادات" Style="{StaticResource PrimaryTabStyle}">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Top Toolbar for Expenses -->
                        <Border Grid.Row="0" Background="{StaticResource CardBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,12" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="➕ تسجيل مصروف جديد" Command="{Binding OpenNewExpenseModalCommand}" 
                                        Background="#DC2626" Foreground="White" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0" />

                                <Button Content="🖨️ طباعة تقرير المصروفات" Command="{Binding PrintExpensesReportCommand}" 
                                        Background="{StaticResource GoldAccentBrush}" Foreground="#0F172A" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0" />
                            </StackPanel>
                        </Border>

                        <!-- Expenses Table -->
                        <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="12" Padding="14" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                            <DataGrid ItemsSource="{Binding Expenses}" AutoGenerateColumns="False" 
                                      CanUserAddRows="False" IsReadOnly="True" Background="#0D1B36" Foreground="{StaticResource TextLightBrush}" 
                                      BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="رقم السند" Binding="{Binding VoucherNumber}" Width="130" />
                                    <DataGridTextColumn Header="البند / التصنيف" Binding="{Binding Category}" Width="150" />
                                    <DataGridTextColumn Header="الجهة المستلمة" Binding="{Binding Recipient}" Width="150" />
                                    <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat='{}{0:N0} ر.ي'}" Width="120" />
                                    <DataGridTextColumn Header="التاريخ" Binding="{Binding ExpenseDate, StringFormat='{}{0:yyyy/MM/dd}'}" Width="110" />
                                    <DataGridTextColumn Header="طريقة الدفع" Binding="{Binding PaymentMethod}" Width="100" />
                                    <DataGridTextColumn Header="البيان" Binding="{Binding Description}" Width="200" />
                                    <DataGridTextColumn Header="المحرر" Binding="{Binding RecordedByName}" Width="130" />
                                    <DataGridTemplateColumn Header="طباعة السند" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="🖨️ طباعة السند" 
                                                        Command="{Binding DataContext.PrintExpenseVoucherCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                        CommandParameter="{Binding}" 
                                                        Background="#3B82F6" Foreground="White" FontWeight="Bold" FontSize="11" Padding="8,4" BorderThickness="0" Cursor="Hand" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB 5: كشوف الحسابات والتقارير المالية -->
                <TabItem Header="📑 كشوف الحسابات والتقارير" Style="{StaticResource PrimaryTabStyle}">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Statement Filter Controls -->
                        <Border Grid.Row="0" Background="{StaticResource CardBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,12" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="نوع الحساب:" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0" FontSize="12" />
                                <ComboBox Grid.Column="1" SelectedValue="{Binding StmtAccountType, Mode=TwoWay}" SelectedValuePath="Tag" Height="32" FontSize="12">
                                    <ComboBoxItem Content="موظف" Tag="employee" IsSelected="True" />
                                    <ComboBoxItem Content="عميل" Tag="customer" />
                                    <ComboBoxItem Content="الصندوق الرئيسي" Tag="cashbox" />
                                </ComboBox>

                                <TextBlock Grid.Column="2" Text="رقم المعرف:" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Margin="12,0,6,0" FontSize="12" />
                                <TextBox Grid.Column="3" Text="{Binding StmtEntityId, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" Padding="8,0" Background="#0F172A" Foreground="White" BorderBrush="{StaticResource BorderLightBrush}" />

                                <TextBlock Grid.Column="4" Text="من تاريخ:" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Margin="12,0,6,0" FontSize="12" />
                                <DatePicker Grid.Column="5" SelectedDate="{Binding StmtFromDate}" Height="32" />

                                <TextBlock Grid.Column="6" Text="إلى تاريخ:" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Margin="12,0,6,0" FontSize="12" />
                                <DatePicker Grid.Column="7" SelectedDate="{Binding StmtToDate}" Height="32" />

                                <Button Grid.Column="8" Content="🔎 عرض كشف الحساب" Command="{Binding SearchStatementCommand}" 
                                        Background="#2563EB" Foreground="White" Style="{StaticResource ActionButtonStyle}" Margin="12,0,0,0" />

                                <Button Grid.Column="9" Content="🖨️ طباعة كشف الحساب الاحترافي" Command="{Binding PrintCurrentStatementCommand}" 
                                        Background="{StaticResource GoldAccentBrush}" Foreground="#0F172A" Style="{StaticResource ActionButtonStyle}" Margin="8,0,0,0" />
                            </Grid>
                        </Border>

                        <!-- Summary Banner for Statement -->
                        <Border Grid.Row="1" Background="#162544" CornerRadius="12" Padding="14" Margin="0,0,0,12" BorderBrush="{StaticResource GoldAccentBrush}" BorderThickness="1.5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding CurrentStatement.AccountOrEntityName, StringFormat='📑 كشف حساب: {0}'}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextLightBrush}" />
                                    <TextBlock Text="كشف حركات الحساب التفصيلي معتمد ومطابق للقيود" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="رصيد بداية المدة" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding CurrentStatement.OpeningBalance, StringFormat='{}{0:N0} ر.ي'}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextLightBrush}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="إجمالي المدين (+)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding CurrentStatement.TotalDebit, StringFormat='{}{0:N0} ر.ي'}" FontSize="15" FontWeight="Bold" Foreground="#10B981" />
                                </StackPanel>

                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="إجمالي الدائن (-)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding CurrentStatement.TotalCredit, StringFormat='{}{0:N0} ر.ي'}" FontSize="15" FontWeight="Bold" Foreground="#EF4444" />
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="الرصيد الختامي" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding CurrentStatement.ClosingBalance, StringFormat='{}{0:N0} ر.ي'}" FontSize="16" FontWeight="Black" Foreground="{StaticResource GoldAccentBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Statement Rows Table -->
                        <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="12" Padding="14" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                            <DataGrid ItemsSource="{Binding CurrentStatement.Rows}" AutoGenerateColumns="False" 
                                      CanUserAddRows="False" IsReadOnly="True" Background="#0D1B36" Foreground="{StaticResource TextLightBrush}" 
                                      BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat='{}{0:yyyy/MM/dd}'}" Width="110" />
                                    <DataGridTextColumn Header="الوقت" Binding="{Binding Time}" Width="90" />
                                    <DataGridTextColumn Header="البيان / تفاصيل الحركة" Binding="{Binding Description}" Width="*" />
                                    <DataGridTextColumn Header="مدين (+)" Binding="{Binding Debit, StringFormat='{}{0:N0}'}" Width="120" />
                                    <DataGridTextColumn Header="دائن (-)" Binding="{Binding Credit, StringFormat='{}{0:N0}'}" Width="120" />
                                    <DataGridTextColumn Header="الرصيد المتراكم" Binding="{Binding Balance, StringFormat='{}{0:N0} ر.ي'}" Width="140" />
                                    <DataGridTextColumn Header="رقم المرجع" Binding="{Binding ReferenceNumber}" Width="130" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>

            </TabControl>
        </Grid>

        <!-- =============================================================== -->
        <!-- MODALS OVERLAY DIALOGS (حفظ البيانات في قاعدة البيانات مع الطباعة) -->
        <!-- =============================================================== -->

        <!-- MODAL 1: تسجيل موظف جديد -->
        <Grid Visibility="{Binding IsNewEmployeeModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}" Panel.ZIndex="2000">
            <Border Background="#80000000" />
            <Border Width="520" Background="#0F172A" BorderBrush="{StaticResource GoldAccentBrush}" BorderThickness="1.5" CornerRadius="14" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="👤 تسجيل موظف جديد في الاستديو" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextLightBrush}" Margin="0,0,0,16" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="اسم الموظف الكامل *" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4" />
                            <TextBox Text="{Binding NewEmpName, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="8,0" Background="#1E293B" Foreground="White" BorderBrush="{StaticResource BorderLightBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="الرقم الوظيفي (اختياري)" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4" />
                            <TextBox Text="{Binding NewEmpNumber, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="8,0" Background="#1E293B" Foreground="White" BorderBrush="{StaticResource BorderLightBrush}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="الوظيفة / التخصص" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4" />
                            <TextBox Text="{Binding NewEmpRole, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="8,0" Background="#1E293B" Foreground="White" BorderBrush="{StaticResource BorderLightBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="رقم الهاتف" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4" />
                            <TextBox Text="{Binding NewEmpPhone, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="8,0" Background="#1E293B" Foreground="White" BorderBrush="{StaticResource BorderLightBrush}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="الراتب الشهري المتفق عليه (ر.ي) *" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4" />
                            <TextBox Text="{Binding NewEmpSalary, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="8,0" Background="#1E293B" Foreground="White" BorderBrush="{StaticResource BorderLightBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="المديونية السابقة / الرصيد الافتتاحي" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4" />
                            <TextBox Text="{Binding NewEmpOpeningDebt, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="8,0" Background="#1E293B" Foreground="White" BorderBrush="{StaticResource BorderLightBrush}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="تاريخ التوظيف" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4" />
                        <DatePicker SelectedDate="{Binding NewEmpHireDate}" Height="34" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="الملاحظات" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewEmpNotes, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Padding="8" Background="#1E293B" Foreground="White" BorderBrush="{StaticResource BorderLightBrush}" />
                    </StackPanel>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="💾 حفظ في قاعدة البيانات" Command="{Binding SaveNewEmployeeCommand}" 
                                Background="{StaticResource GoldAccentBrush}" Foreground="#0F172A" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" />
                        <Button Content="✕ إلغاء" Command="{Binding CloseNewEmployeeModalCommand}" 
                                Background="#334155" Foreground="White" Style="{StaticResource ActionButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MODAL 2: تسجيل سلفة -->
        <Grid Visibility="{Binding IsAdvanceModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}" Panel.ZIndex="2000">
            <Border Background="#80000000" />
            <Border Width="450" Background="#0F172A" BorderBrush="#2563EB" BorderThickness="1.5" CornerRadius="14" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="💵 تسجيل سلفة نقدية على الراتب" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextLightBrush}" Margin="0,0,0,16" />

                    <TextBlock Text="{Binding SelectedAdvanceEmp.Name, StringFormat='الموظف: {0}'}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource GoldAccentBrush}" Margin="0,0,0,12" />

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="مبلغ السلفة (ر.ي) *" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox Text="{Binding AdvanceAmount, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="8,0" Background="#1E293B" Foreground="White" BorderBrush="{StaticResource BorderLightBrush}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="تاريخ السلفة" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4" />
                        <DatePicker SelectedDate="{Binding AdvanceDate}" Height="34" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="البيان والملاحظات" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox Text="{Binding AdvanceNotes, UpdateSourceTrigger=PropertyChanged}" Height="50" Padding="8" Background="#1E293B" Foreground="White" BorderBrush="{StaticResource BorderLightBrush}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="💾 حفظ السلفة وإنشاء سند الصرف" Command="{Binding SaveAdvanceCommand}" 
                                Background="#2563EB" Foreground="White" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" />
                        <Button Content="✕ إلغاء" Command="{Binding CloseAdvanceModalCommand}" 
                                Background="#334155" Foreground="White" Style="{StaticResource ActionButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MODAL 3: تسجيل خصم -->
        <Grid Visibility="{Binding IsDeductionModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}" Panel.ZIndex="2000">
            <Border Background="#80000000" />
            <Border Width="450" Background="#0F172A" BorderBrush="#DC2626" BorderThickness="1.5" CornerRadius="14" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="✂️ تسجيل خصم إداري / جزاء" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextLightBrush}" Margin="0,0,0,16" />

                    <TextBlock Text="{Binding SelectedDeductionEmp.Name, StringFormat='الموظف: {0}'}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource GoldAccentBrush}" Margin="0,0,0,12" />

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="مبلغ الخصم (ر.ي) *" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox Text="{Binding DeductionAmount, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="8,0" Background="#1E293B" Foreground="White" BorderBrush="{StaticResource BorderLightBrush}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="سبب الخصم *" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox Text="{Binding DeductionReason, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="8,0" Background="#1E293B" Foreground="White" BorderBrush="{StaticResource BorderLightBrush}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="تاريخ الخصم" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4" />
                        <DatePicker SelectedDate="{Binding DeductionDate}" Height="34" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="💾 حفظ الخصم" Command="{Binding SaveDeductionCommand}" 
                                Background="#DC2626" Foreground="White" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" />
                        <Button Content="✕ إلغاء" Command="{Binding CloseDeductionModalCommand}" 
                                Background="#334155" Foreground="White" Style="{StaticResource ActionButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MODAL 4: تسجيل مديونية على الموظف -->
        <Grid Visibility="{Binding IsDebtModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}" Panel.ZIndex="2000">
            <Border Background="#80000000" />
            <Border Width="450" Background="#0F172A" BorderBrush="#EA580C" BorderThickness="1.5" CornerRadius="14" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="⚠️ تسجيل مديونية مستحقة على الموظف" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextLightBrush}" Margin="0,0,0,16" />

                    <TextBlock Text="{Binding SelectedDebtEmp.Name, StringFormat='الموظف المدين: {0}'}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource GoldAccentBrush}" Margin="0,0,0,12" />

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="مبلغ المديونية (ر.ي) *" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox Text="{Binding DebtAmount, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="8,0" Background="#1E293B" Foreground="White" BorderBrush="{StaticResource BorderLightBrush}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="سبب المديونية *" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox Text="{Binding DebtReason, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="8,0" Background="#1E293B" Foreground="White" BorderBrush="{StaticResource BorderLightBrush}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="تاريخ المديونية" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4" />
                        <DatePicker SelectedDate="{Binding DebtDate}" Height="34" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="ملاحظات وتفاصيل إضافية" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox Text="{Binding DebtNotes, UpdateSourceTrigger=PropertyChanged}" Height="50" Padding="8" Background="#1E293B" Foreground="White" BorderBrush="{StaticResource BorderLightBrush}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="💾 حفظ المديونية" Command="{Binding SaveDebtCommand}" 
                                Background="#EA580C" Foreground="White" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" />
                        <Button Content="✕ إلغاء" Command="{Binding CloseDebtModalCommand}" 
                                Background="#334155" Foreground="White" Style="{StaticResource ActionButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MODAL 5: سداد دفعة / مديونية موظف -->
        <Grid Visibility="{Binding IsPaymentModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}" Panel.ZIndex="2000">
            <Border Background="#80000000" />
            <Border Width="450" Background="#0F172A" BorderBrush="#16A34A" BorderThickness="1.5" CornerRadius="14" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="💳 سداد دفعة نقدية / تسوية مديونية" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextLightBrush}" Margin="0,0,0,16" />

                    <TextBlock Text="{Binding SelectedPaymentEmp.Name, StringFormat='الموظف المسدد: {0}'}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource GoldAccentBrush}" Margin="0,0,0,12" />

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="مبلغ الدفعة المسددة (ر.ي) *" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="8,0" Background="#1E293B" Foreground="White" BorderBrush="{StaticResource BorderLightBrush}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="البيان" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox Text="{Binding PaymentDesc, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="8,0" Background="#1E293B" Foreground="White" BorderBrush="{StaticResource BorderLightBrush}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="تاريخ السداد" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4" />
                        <DatePicker SelectedDate="{Binding PaymentDate}" Height="34" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="💾 توريد وحفظ السداد بالصندوق" Command="{Binding SaveEmployeePaymentCommand}" 
                                Background="#16A34A" Foreground="White" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" />
                        <Button Content="✕ إلغاء" Command="{Binding ClosePaymentModalCommand}" 
                                Background="#334155" Foreground="White" Style="{StaticResource ActionButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MODAL 6: صرف وتصفية الراتب الشهري -->
        <Grid Visibility="{Binding IsSalaryModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}" Panel.ZIndex="2000">
            <Border Background="#80000000" />
            <Border Width="500" Background="#0F172A" BorderBrush="#059669" BorderThickness="1.5" CornerRadius="14" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="💰 صرف وتصفية الراتب الشهري" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextLightBrush}" Margin="0,0,0,16" />

                    <TextBlock Text="{Binding SelectedSalaryEmp.Name, StringFormat='الموظف: {0}'}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource GoldAccentBrush}" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="الشهر المستهدف *" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4" />
                            <TextBox Text="{Binding SalaryMonthYear, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="8,0" Background="#1E293B" Foreground="White" BorderBrush="{StaticResource BorderLightBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="الراتب الأساسي (ر.ي)" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4" />
                            <TextBox Text="{Binding SalaryBaseAmount, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="8,0" Background="#1E293B" Foreground="White" BorderBrush="{StaticResource BorderLightBrush}" IsReadOnly="True" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="البدلات والمكافآت (+)" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4" />
                            <TextBox Text="{Binding SalaryAllowances, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="8,0" Background="#1E293B" Foreground="White" BorderBrush="{StaticResource BorderLightBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="الخصومات والجزاءات (-)" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4" />
                            <TextBox Text="{Binding SalaryDeductions, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="8,0" Background="#1E293B" Foreground="White" BorderBrush="{StaticResource BorderLightBrush}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="السلف المستقطعة من الراتب (-)" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox Text="{Binding SalaryAdvancesDeducted, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="8,0" Background="#1E293B" Foreground="White" BorderBrush="{StaticResource BorderLightBrush}" />
                    </StackPanel>

                    <!-- Net Salary Banner -->
                    <Border Background="#162544" CornerRadius="10" Padding="12" Margin="0,0,0,16" BorderBrush="#059669" BorderThickness="1">
                        <Grid>
                            <TextBlock Text="صافي الراتب المستحق المصروف:" FontSize="13" Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SalaryNetDue, StringFormat='{}{0:N0} ر.ي'}" FontSize="18" FontWeight="Black" Foreground="#10B981" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="💾 اعتماد وصرف الراتب" Command="{Binding SaveSalaryPaymentCommand}" 
                                Background="#059669" Foreground="White" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" />
                        <Button Content="✕ إلغاء" Command="{Binding CloseSalaryModalCommand}" 
                                Background="#334155" Foreground="White" Style="{StaticResource ActionButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MODAL 7: سند قبض / صرف مالي جديد -->
        <Grid Visibility="{Binding IsNewVoucherModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}" Panel.ZIndex="2000">
            <Border Background="#80000000" />
            <Border Width="500" Background="#0F172A" BorderBrush="{StaticResource GoldAccentBrush}" BorderThickness="1.5" CornerRadius="14" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding NewVoucherTypeTitle}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextLightBrush}" Margin="0,0,0,16" />

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="المستفيد / الدافع *" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewVoucherBeneficiary, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="8,0" Background="#1E293B" Foreground="White" BorderBrush="{StaticResource BorderLightBrush}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="المبلغ (ر.ي) *" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewVoucherAmount, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="8,0" Background="#1E293B" Foreground="White" BorderBrush="{StaticResource BorderLightBrush}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="البيان والسبب *" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewVoucherDescription, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="8,0" Background="#1E293B" Foreground="White" BorderBrush="{StaticResource BorderLightBrush}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="ملاحظات" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewVoucherNotes, UpdateSourceTrigger=PropertyChanged}" Height="50" Padding="8" Background="#1E293B" Foreground="White" BorderBrush="{StaticResource BorderLightBrush}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="💾 حفظ السند ومعاينته" Command="{Binding SaveVoucherCommand}" 
                                Background="{StaticResource GoldAccentBrush}" Foreground="#0F172A" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" />
                        <Button Content="✕ إلغاء" Command="{Binding CloseNewVoucherModalCommand}" 
                                Background="#334155" Foreground="White" Style="{StaticResource ActionButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MODAL 8: تسجيل مصروف جديد -->
        <Grid Visibility="{Binding IsNewExpenseModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}" Panel.ZIndex="2000">
            <Border Background="#80000000" />
            <Border Width="450" Background="#0F172A" BorderBrush="#DC2626" BorderThickness="1.5" CornerRadius="14" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="💳 تسجيل مصروف جديد" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextLightBrush}" Margin="0,0,0,16" />

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="بند / تصنيف المصروف *" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewExpenseCategory, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="8,0" Background="#1E293B" Foreground="White" BorderBrush="{StaticResource BorderLightBrush}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="المبلغ (ر.ي) *" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewExpenseAmount, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="8,0" Background="#1E293B" Foreground="White" BorderBrush="{StaticResource BorderLightBrush}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="الجهة المستلمة" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewExpenseRecipient, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="8,0" Background="#1E293B" Foreground="White" BorderBrush="{StaticResource BorderLightBrush}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="البيان والتفاصيل" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewExpenseDesc, UpdateSourceTrigger=PropertyChanged}" Height="50" Padding="8" Background="#1E293B" Foreground="White" BorderBrush="{StaticResource BorderLightBrush}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="💾 حفظ المصروف في الخزينة" Command="{Binding SaveExpenseCommand}" 
                                Background="#DC2626" Foreground="White" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" />
                        <Button Content="✕ إلغاء" Command="{Binding CloseNewExpenseModalCommand}" 
                                Background="#334155" Foreground="White" Style="{StaticResource ActionButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
