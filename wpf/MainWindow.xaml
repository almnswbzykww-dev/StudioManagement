<Window x:Class="StudioManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StudioManagement"
        mc:Ignorable="d"
        Title="استديو الفن 3 - تسجيل الدخول"
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI, Tahoma, Arial"
        FlowDirection="RightToLeft">

    <Window.Resources>
        <!-- Golden Luxury Gradient Brushes -->
        <LinearGradientBrush x:Key="GoldButtonBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F3B246" Offset="0.0"/>
            <GradientStop Color="#D48B28" Offset="0.5"/>
            <GradientStop Color="#BA721B" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GoldBorderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F59E0B" Offset="0.0"/>
            <GradientStop Color="#D97706" Offset="0.5"/>
            <GradientStop Color="#78350F" Offset="1.0"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="DarkCardBrush" Color="#EE080F1E"/>
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#660B162C"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#44334155"/>
        <SolidColorBrush x:Key="InputFocusBorderBrush" Color="#F59E0B"/>

        <!-- Custom Glass Input TextBox Style -->
        <Style x:Key="GlassInputTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#A0D97706"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource InputFocusBorderBrush}"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#F59E0B" BlurRadius="12" Opacity="0.4" ShadowDepth="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Glass PasswordBox Style -->
        <Style x:Key="GlassPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#A0D97706"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource InputFocusBorderBrush}"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#F59E0B" BlurRadius="12" Opacity="0.4" ShadowDepth="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Luxury Golden Button Style -->
        <Style x:Key="GoldLuxuryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource GoldButtonBrush}"/>
            <Setter Property="Foreground" Value="#0A0F1D"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16"
                                Padding="16,12">
                            <Border.Effect>
                                <DropShadowEffect Color="#F59E0B" BlurRadius="25" Opacity="0.45" ShadowDepth="4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FBBF24" BlurRadius="35" Opacity="0.75" ShadowDepth="5"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Control Button Style -->
        <Style x:Key="WindowControlBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseBtn" TargetType="Button" BasedOn="{StaticResource WindowControlBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E11D48"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 1. Fullscreen Photographic Studio Background (Loaded from Local Assets) -->
        <Image Source="pack://application:,,,/Resources/studio_background.jpg" 
               Stretch="UniformToFill" 
               HorizontalAlignment="Center" 
               VerticalAlignment="Center"/>

        <!-- Dark Cinematic Vignette & Ambient Radial Lighting Overlay -->
        <Border Background="#45000000"/>

        <!-- 2. Window Title Bar & Native Window Controls (Top) -->
        <Grid VerticalAlignment="Top" Height="40" Background="#25050B14">
            <!-- Draggable Area -->
            <Border MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent"/>

            <!-- App Title in TitleBar -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0,0,0">
                <Path Data="M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z" 
                      Fill="#F59E0B" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                <TextBlock Text="استديو الفن 3 - نظام إدارة الاستديو والإنتاج" 
                           Foreground="#D1D5DB" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Working Window Control Buttons (Minimize, Maximize/Restore, Close) -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" FlowDirection="LeftToRight">
                <!-- Minimize Button (-) -->
                <Button Style="{StaticResource WindowControlBtn}" Click="BtnMinimize_Click" ToolTip="تصغير النافذة (-)">
                    <Path Data="M 0,0 L 10,0" Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="10" Height="2"/>
                </Button>

                <!-- Maximize / Restore Button (□) -->
                <Button x:Name="BtnMaximizeRestore" Style="{StaticResource WindowControlBtn}" Click="BtnMaximizeRestore_Click" ToolTip="تكبير / استعادة الحجم (□)">
                    <Path x:Name="MaximizeIconPath" Data="M 0,0 L 10,0 L 10,10 L 0,10 Z" Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="10" Height="10"/>
                </Button>

                <!-- Close Button (X) -->
                <Button Style="{StaticResource WindowCloseBtn}" Click="BtnClose_Click" ToolTip="إغلاق البرنامج (X)">
                    <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="10" Height="10"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 3. Central Login Camera Viewfinder Frame (Matching Reference Image 100%) -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Main Viewfinder Glass Card -->
            <Border x:Name="ViewfinderCard"
                    Width="560"
                    Background="{StaticResource DarkCardBrush}"
                    BorderBrush="{StaticResource GoldBorderBrush}"
                    BorderThickness="2"
                    CornerRadius="34"
                    Padding="38,34">
                <Border.Effect>
                    <DropShadowEffect Color="#F59E0B" BlurRadius="60" Opacity="0.3" ShadowDepth="0"/>
                </Border.Effect>

                <Grid>
                    <!-- Viewfinder Top Glowing Neon Horizontal Accent -->
                    <Border Height="2" Width="140" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-29,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00F59E0B" Offset="0.0"/>
                                <GradientStop Color="#FFF59E0B" Offset="0.5"/>
                                <GradientStop Color="#00F59E0B" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- L-Shaped Golden Viewfinder Corner Brackets (Matching Image Exactly) -->
                    <!-- Top-Right L-Bracket -->
                    <Path Data="M 0,0 L 26,0 L 26,26" Stroke="#F59E0B" StrokeThickness="2.5" 
                          HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,4,0"/>

                    <!-- Top-Left L-Bracket -->
                    <Path Data="M 26,0 L 0,0 L 0,26" Stroke="#F59E0B" StrokeThickness="2.5" 
                          HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,0,0,0"/>

                    <!-- Bottom-Right L-Bracket -->
                    <Path Data="M 0,26 L 26,26 L 26,0" Stroke="#F59E0B" StrokeThickness="2.5" 
                          HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,0"/>

                    <!-- Bottom-Left L-Bracket -->
                    <Path Data="M 26,26 L 0,26 L 0,0" Stroke="#F59E0B" StrokeThickness="2.5" 
                          HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4,0,0,0"/>

                    <!-- Inside Camera Viewfinder Content -->
                    <StackPanel Orientation="Vertical">
                        
                        <!-- 1. Enlarged Golden Camera Crown Emblem Logo -->
                        <Grid HorizontalAlignment="Center" Margin="0,4,0,14">
                            <!-- Ambient Halo -->
                            <Ellipse Width="150" Height="150" Fill="#18F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse.Effect>
                                    <BlurEffect Radius="25"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <!-- Outer Lens Glow Circle -->
                            <Ellipse Width="124" Height="124" Stroke="#50F59E0B" StrokeThickness="1.5"/>
                            <!-- Inner Gold Rim -->
                            <Ellipse Width="110" Height="110" Stroke="#D0F59E0B" StrokeThickness="3"/>
                            <!-- Center Lens Radial Gradient -->
                            <Ellipse Width="88" Height="88">
                                <Ellipse.Fill>
                                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.4,0.3" RadiusX="0.5" RadiusY="0.5">
                                        <GradientStop Color="#2563EB" Offset="0.0"/>
                                        <GradientStop Color="#1E293B" Offset="0.6"/>
                                        <GradientStop Color="#020617" Offset="1.0"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>

                            <!-- Royal Golden Crown on Top -->
                            <Path Data="M 3,14 L 6,4 L 11,9 L 16,3 L 21,9 L 26,4 L 29,14 Z" 
                                  Fill="#FBBF24" Stroke="#D97706" StrokeThickness="1.2"
                                  HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-22,0,0" Width="52" Height="24" Stretch="Uniform"/>
                            
                            <!-- Center Lens Reflex Highlight Dot -->
                            <Ellipse Width="9" Height="9" Fill="#93C5FD" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-20,-20,0,0"/>
                        </Grid>

                        <!-- 2. Studio Title: استديو الفن 3 -->
                        <Grid HorizontalAlignment="Center" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Rectangle Width="40" Height="1.5" Fill="#D97706" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="استديو الفن 3" FontSize="26" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="#F59E0B" BlurRadius="10" Opacity="0.5" ShadowDepth="0"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                                <Rectangle Width="40" Height="1.5" Fill="#D97706" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- 3. Subtitle: لتصوير والفيديو والإعلانات -->
                        <TextBlock Text="لتصوير والفيديو والإعلانات" 
                                   Foreground="#F59E0B" FontSize="11" FontWeight="Medium" 
                                   HorizontalAlignment="Center" Margin="0,0,0,12"/>

                        <!-- 4. Date + Time + Year Row (Live Updating) -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                            <!-- Calendar Date -->
                            <TextBlock x:Name="TxtCurrentDate" Text="📅 2025-06-17" Foreground="#CBD5E1" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Text=" | " Foreground="#64748B" FontSize="12" Margin="8,0" VerticalAlignment="Center"/>
                            <!-- Clock Time -->
                            <TextBlock x:Name="TxtCurrentTime" Text="⏰ 10:24 م" Foreground="#FDE68A" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Current Year Sub-text -->
                        <TextBlock x:Name="TxtCurrentYear" Text="2025" Foreground="#64748B" FontSize="10" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                        <!-- 5. Login Input Fields in Exact Order -->
                        
                        <!-- Field 1: User Number (رقم المستخدم) -->
                        <Grid Margin="0,0,0,12">
                            <TextBox x:Name="TxtUserNumber" Style="{StaticResource GlassInputTextBox}" Text="1"/>
                            <!-- Right-aligned Placeholder Label -->
                            <TextBlock Text="رقم المستخدم" Foreground="#64748B" FontSize="12" 
                                       IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TxtUserNumber}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- User Profile Icon on Left -->
                            <Path Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"
                                  Fill="#94A3B8" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        </Grid>

                        <!-- Field 2: Username (اسم المستخدم) -->
                        <Grid Margin="0,0,0,12">
                            <TextBox x:Name="TxtUsername" Style="{StaticResource GlassInputTextBox}" Text="admin"/>
                            <!-- Right-aligned Placeholder Label -->
                            <TextBlock Text="اسم المستخدم" Foreground="#64748B" FontSize="12" 
                                       IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TxtUsername}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- Lock Icon on Left -->
                            <Path Data="M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.89,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z"
                                  Fill="#94A3B8" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        </Grid>

                        <!-- Field 3: Password (كلمة المرور) -->
                        <Grid Margin="0,0,0,18">
                            <PasswordBox x:Name="TxtPassword" Style="{StaticResource GlassPasswordBox}" Password="admin"/>
                            <TextBox x:Name="TxtPasswordVisible" Style="{StaticResource GlassInputTextBox}" Visibility="Collapsed"/>
                            
                            <!-- Placeholder Label -->
                            <TextBlock Text="كلمة المرور" Foreground="#64748B" FontSize="12" 
                                       IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Password, ElementName=TxtPassword}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Eye Visibility Toggle Button (Left) -->
                            <Button x:Name="BtnTogglePassword" Click="BtnTogglePassword_Click" 
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0">
                                <Path x:Name="EyeIconPath" Data="M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z"
                                      Fill="#94A3B8" Width="16" Height="16" Stretch="Uniform"/>
                            </Button>
                        </Grid>

                        <!-- 6. Big Golden Luxury Login Button (تسجيل الدخول) -->
                        <Button x:Name="BtnLogin" Style="{StaticResource GoldLuxuryButton}" Click="BtnLogin_Click" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="تسجيل الدخول" FontSize="15" FontWeight="Black" Foreground="#0A0F1D" VerticalAlignment="Center"/>
                                <Path Data="M14.08,15.59L16.67,13H8V11H16.67L14.08,8.41L15.5,7L20.5,12L15.5,17L14.08,15.59M19,3A2,2 0 0,1 21,5V9.67L19,7.67V5H5V19H19V16.33L21,14.33V19A2,2 0 0,1 19,21H5C3.89,21 3,20.1 3,19V5C3,3.89 3.89,3 5,3H19Z"
                                      Fill="#0A0F1D" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- Bottom Tagline Quote -->
                        <TextBlock Text="── بإبداعنا .. نصنع أجمل اللحظات ──" 
                                   Foreground="#64748B" FontSize="11" FontWeight="Medium" 
                                   HorizontalAlignment="Center" Margin="0,0,0,2"/>

                    </StackPanel>

                    <!-- 7. In-Viewfinder Camera HUD Notification Overlay (Requested by User) -->
                    <!-- Appears in the center of the camera viewfinder frame with smooth animation -->
                    <Border x:Name="HudNotificationBorder"
                            Background="#F0091326"
                            BorderBrush="#F59E0B"
                            BorderThickness="1.5"
                            CornerRadius="20"
                            Padding="24,18"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            Opacity="0">
                        <Border.Effect>
                            <DropShadowEffect Color="#F59E0B" BlurRadius="30" Opacity="0.5" ShadowDepth="0"/>
                        </Border.Effect>
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <Path x:Name="HudNotificationIcon" 
                                  Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M11,16.5L6.5,12L7.91,10.59L11,13.67L16.59,8.09L18,9.5L11,16.5Z"
                                  Fill="#10B981" Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            
                            <TextBlock x:Name="HudNotificationTitle" Text="تنبيه الكاميرا" 
                                       Foreground="#FBBF24" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            
                            <TextBlock x:Name="HudNotificationMessage" Text="تم تسجيل الدخول بنجاح!" 
                                       Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="280"/>
                        </StackPanel>
                    </Border>

                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
