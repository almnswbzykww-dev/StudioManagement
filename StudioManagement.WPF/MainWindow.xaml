<Window x:Class="StudioManagement.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StudioManagement.WPF.ViewModels"
        Title="StudioManagement - استديو التصوير والطباعة"
        Height="780" Width="1240"
        MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="{StaticResource SurfaceBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="{StaticResource BrandPrimaryBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Studio Logo & Name -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="8" Background="{StaticResource BrandAccentBlueBrush}" Margin="0,0,12,0">
                        <TextBlock Text="📸" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding StudioName}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextLightBrush}" />
                        <TextBlock Text="نظام إدارة استديو التصوير والطباعة المتكامل" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- English Clock & Notifications Bell & User Role & Window Control Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Live English Clock (Day, Date & Time) -->
                    <Border Background="#1C2541" CornerRadius="8" Padding="12,6" Margin="0,0,10,0" FlowDirection="LeftToRight">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CurrentTimeFormatted}" Foreground="{StaticResource BrandAccentGoldBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="•" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding CurrentDateFormatted}" Foreground="{StaticResource TextLightBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Notifications Bell Button with Unread Badge -->
                    <Border Margin="0,0,10,0">
                        <Grid>
                            <Button Command="{Binding ToggleNotificationsCommand}"
                                    Width="38" Height="34" Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                                    Cursor="Hand" ToolTip="التنبيهات والإشعارات النظامية (انقر للمعاينة)">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8" />
                                    </Style>
                                </Button.Resources>
                                <TextBlock Text="🔔" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <!-- Badge -->
                            <Border Visibility="{Binding HasUnreadNotifications, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Background="#EF4444" CornerRadius="8" MinWidth="18" Height="18" Padding="3,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0" IsHitTestVisible="False">
                                <TextBlock Text="{Binding UnreadNotificationCount}" Foreground="White" FontSize="10" FontWeight="Black"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- User Role -->
                    <Border Background="#1E293B" CornerRadius="8" Padding="12,6" Margin="0,0,10,0">
                        <TextBlock Text="{Binding CurrentUserRoleName}" Foreground="{StaticResource TextLightBrush}" FontSize="12" FontWeight="Bold" />
                    </Border>

                    <!-- Active Desktop Windows Control Buttons: Minimize, Maximize/Restore, Close -->
                    <Border Background="#0F172A" CornerRadius="8" Padding="4,2" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                            <!-- Minimize Button (-) -->
                            <Button Content="—" Command="{Binding MinimizeWindowCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                    Width="30" Height="26" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontWeight="Bold" FontSize="11" Cursor="Hand" ToolTip="تصغير النافذة (-)" />
                            
                            <!-- Maximize / Restore Button (□) -->
                            <Button Content="▢" Command="{Binding MaximizeWindowCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                    Width="30" Height="26" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontWeight="Bold" FontSize="13" Cursor="Hand" ToolTip="تكبير / استعادة الحجم (□)" />
                            
                            <!-- Close Button (✕) -->
                            <Button Content="✕" Command="{Binding CloseWindowCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                    Width="30" Height="26" Background="#DC2626" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="12" Cursor="Hand" ToolTip="إغلاق البرنامج (✕)">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6" />
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body: Sidebar + Dynamic Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource BrandSecondaryBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,12">
                        <Button Content="📊 الرئيسية (لوحة التحكم)" Command="{Binding GoToDashboardCommand}" Margin="0,2" Padding="12,10" Background="Transparent" Foreground="{StaticResource TextLightBrush}" BorderThickness="0" HorizontalContentAlignment="Right" FontSize="13" Cursor="Hand" />
                        <Button Content="👥 إدارة العملاء" Command="{Binding GoToCustomersCommand}" Margin="0,2" Padding="12,10" Background="Transparent" Foreground="{StaticResource TextLightBrush}" BorderThickness="0" HorizontalContentAlignment="Right" FontSize="13" Cursor="Hand" />
                        <Button Content="📦 سجل الطلبات" Command="{Binding GoToOrdersCommand}" Margin="0,2" Padding="12,10" Background="Transparent" Foreground="{StaticResource TextLightBrush}" BorderThickness="0" HorizontalContentAlignment="Right" FontSize="13" Cursor="Hand" />
                        <Separator Margin="0,8" Background="{StaticResource BorderLightBrush}" />
                        <Button Content="📦 المخزون والخامات" Command="{Binding GoToInventoryCommand}" Margin="0,2" Padding="12,10" Background="Transparent" Foreground="{StaticResource TextLightBrush}" BorderThickness="0" HorizontalContentAlignment="Right" FontSize="13" Cursor="Hand" />
                        <Button Content="🏭 الموردون والمشتريات" Command="{Binding GoToSuppliersCommand}" Margin="0,2" Padding="12,10" Background="Transparent" Foreground="{StaticResource TextLightBrush}" BorderThickness="0" HorizontalContentAlignment="Right" FontSize="13" Cursor="Hand" />
                        <Button Content="💰 المحاسبة والصندوق" Command="{Binding GoToAccountingCommand}" Margin="0,2" Padding="12,10" Background="Transparent" Foreground="{StaticResource TextLightBrush}" BorderThickness="0" HorizontalContentAlignment="Right" FontSize="13" Cursor="Hand" />
                        <Button Content="📈 التقارير المالية" Command="{Binding GoToReportsCommand}" Margin="0,2" Padding="12,10" Background="Transparent" Foreground="{StaticResource TextLightBrush}" BorderThickness="0" HorizontalContentAlignment="Right" FontSize="13" Cursor="Hand" />
                        <Separator Margin="0,8" Background="{StaticResource BorderLightBrush}" />
                        <Button Content="⚙️ إعدادات الاستديو" Command="{Binding GoToSettingsCommand}" Margin="0,2" Padding="12,10" Background="Transparent" Foreground="{StaticResource TextLightBrush}" BorderThickness="0" HorizontalContentAlignment="Right" FontSize="13" Cursor="Hand" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Dynamic Viewport -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" Margin="16" />

            <!-- Notifications Flyout Overlay Panel -->
            <Border Grid.ColumnSpan="2" Visibility="{Binding IsNotificationsOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="230,8,0,0" Width="430" MaxHeight="560"
                    Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="14" Panel.ZIndex="1000">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="6" Opacity="0.6" Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔔 التنبيهات والإشعارات" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" />
                            <Border Background="#EF4444" CornerRadius="10" Padding="8,2" Margin="8,0,0,0"
                                    Visibility="{Binding HasUnreadNotifications, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding UnreadNotificationCount, StringFormat='{}{0} غير مقروء'}" Foreground="White" FontSize="11" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✓ تعليم الكل كمقروء" Command="{Binding MarkAllNotificationsAsReadCommand}"
                                Background="Transparent" Foreground="#38BDF8" BorderThickness="0" FontSize="11" Cursor="Hand" Margin="0,0,8,0" />
                        <Button Grid.Column="2" Content="✕" Command="{Binding ToggleNotificationsCommand}"
                                Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontSize="14" FontWeight="Bold" Cursor="Hand" Width="24" Height="24" />
                    </Grid>

                    <Separator Grid.Row="0" VerticalAlignment="Bottom" Background="#334155" Margin="0,2" />

                    <!-- Notifications List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="400" Margin="0,8,0,0">
                        <ItemsControl ItemsSource="{Binding Notifications}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <!-- Title + Time -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding TypeIcon}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding CreatedAtFormatted}" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" />
                                            </Grid>
                                            <!-- Message -->
                                            <TextBlock Grid.Row="1" Text="{Binding Message}" FontSize="11" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,4,0,8" />
                                            <!-- Action Buttons -->
                                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
                                                <Button Content="📂 فتح العنصر" 
                                                        Command="{Binding DataContext.OpenNotificationItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                        CommandParameter="{Binding}"
                                                        Background="#2563EB" Foreground="White" BorderThickness="0" Padding="8,4" FontSize="10" FontWeight="Bold" Cursor="Hand" Margin="0,0,6,0">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                </Button>
                                                <Button Content="✓ قراءة" 
                                                        Command="{Binding DataContext.MarkNotificationAsReadCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                        CommandParameter="{Binding Id}"
                                                        Background="#334155" Foreground="White" BorderThickness="0" Padding="8,4" FontSize="10" Cursor="Hand" Margin="0,0,6,0">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                </Button>
                                                <Button Content="🗑️" 
                                                        Command="{Binding DataContext.DeleteNotificationCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                        CommandParameter="{Binding Id}"
                                                        Background="Transparent" Foreground="#EF4444" BorderThickness="0" Padding="6,4" FontSize="11" Cursor="Hand" ToolTip="حذف الإشعار" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Border Grid.Row="2" BorderBrush="#334155" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,6,0,0">
                        <Grid>
                            <Button Content="🔄 تحديث التنبيهات" Command="{Binding RefreshNotificationsCommand}"
                                    Background="#1E293B" Foreground="#38BDF8" BorderBrush="#334155" BorderThickness="1" Padding="10,6" FontSize="11" HorizontalAlignment="Left" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                            <Button Content="مسح كافة التنبيهات" Command="{Binding ClearAllNotificationsCommand}"
                                    Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontSize="11" HorizontalAlignment="Right" Cursor="Hand" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
