<UserControl x:Class="StudioManagement.WPF.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,10,0">
            <!-- KPI Summary Cards -->
            <UniformGrid Columns="4" Margin="0,0,0,20">
                <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="16" Margin="6" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="طلبات اليوم" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding Stats.TotalOrdersToday}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextLightBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="16" Margin="6" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="الطلبات الجاهزة" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding Stats.ReadyOrdersCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrandSuccessBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="16" Margin="6" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="ديون العملاء المتبقية" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding Stats.TotalRemainingDebts, StringFormat='{}{0:N0} ر.ي'}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrandAccentGoldBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="16" Margin="6" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="رصيد الصندوق والخزينة" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding Stats.NetCashInTreasury, StringFormat='{}{0:N0} ر.ي'}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrandAccentBlueBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Service Department Big Cards (Requirement 5) -->
            <TextBlock Text="أقسام وخدمات الاستديو المتخصصة" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextLightBrush}" Margin="6,0,0,12" />

            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="14" Margin="6" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                            <StackPanel>
                                <!-- 1. Fixed Image Frame (Offline & Non-clickable) -->
                                <Border Height="110" CornerRadius="8" Background="#0B132B" Margin="0,0,0,10" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="📸" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" />
                                        <Image Source="{Binding ImagePath}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                </Border>

                                <!-- 2. Department Name -->
                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextLightBrush}" HorizontalAlignment="Center" Margin="0,0,0,12" />

                                <!-- 3. Add New Order Button Only -->
                                <Button Content="+ إضافة طلب جديد" Command="{Binding DataContext.OpenServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="{StaticResource BrandAccentBlueBrush}" Foreground="White" FontWeight="Bold" Padding="0,8" BorderThickness="0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8" />
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
